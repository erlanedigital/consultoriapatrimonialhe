{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consultoriapatrimonialhe",
  "main": "worker.js",
  "compatibility_date": "2024-09-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
